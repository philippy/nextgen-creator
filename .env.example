DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Padrão local: ./data. Produção: /var/lib/nextgen-creator
# NEXTGEN_DATA_DIR=/var/lib/nextgen-creator

# Opcional. A origem deve corresponder àquela aberta no navegador.
NEXTGEN_PUBLIC_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
